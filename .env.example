# =================================================================
# आपला दादा पोर्टल - प्रोडक्शन कॉन्फिगरेशन (.env)
# =================================================================

# 1. ॲडमिन क्रेडेंशियल्स (प्रशासकीय कक्ष)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dada@123
ADMIN_EMAIL=office.vaibhavdada@gmail.com

# 2. Firebase Cloud Firestore (Render वर 100% डेटा सुरक्षित ठेवण्यासाठी)
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# डाऊनलोड केलेल्या JSON चा मजकूर खालील FIREBASE_CREDENTIALS_JSON मध्ये एक ओळीत पेस्ट करा:
FIREBASE_CREDENTIALS_JSON=
# किंवा स्थानिक पातळीवर फाईल ठेवायची असल्यास:
# FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# 3. SMTP ईमेल सेवा (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=office.vaibhavdada@gmail.com
OFFICE_NOTIFICATION_EMAIL=office.vaibhavdada@gmail.com

# 4. सर्व्हर सेटिंग्ज
HOST=0.0.0.0
PORT=8000
